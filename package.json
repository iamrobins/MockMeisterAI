{
  "name": "mockmeister",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@interviewflowai/talking-avatar": "0.1.3",
    "express": "5.2.1",
    "openai": "7.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "8.5.13",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
